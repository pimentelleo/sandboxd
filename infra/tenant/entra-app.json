{
  "$schema": "https://schema.management.azure.com/schemas/2019-08-01/tenantDeploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "16231563119271702480"
    }
  },
  "parameters": {
    "applicationDisplayName": {
      "type": "string",
      "metadata": {
        "description": "Display name for the sandboxd Entra application. It is intentionally supplied by the operator."
      }
    },
    "userGroupObjectId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the existing Entra security group granted sandboxd.user."
      }
    },
    "adminGroupObjectId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the existing Entra security group granted sandboxd.admin."
      }
    },
    "homepageUrl": {
      "type": "string",
      "metadata": {
        "description": "Optional homepage URI for the console, such as https://console.example.com."
      }
    }
  },
  "imports": {
    "microsoftGraphV1": {
      "provider": "MicrosoftGraph",
      "version": "1.0.0"
    }
  },
  "resources": {
    "sandboxdApplication": {
      "import": "microsoftGraphV1",
      "type": "Microsoft.Graph/applications@v1.0",
      "properties": {
        "uniqueName": "[parameters('applicationDisplayName')]",
        "displayName": "[parameters('applicationDisplayName')]",
        "signInAudience": "AzureADMyOrg",
        "web": {
          "homePageUrl": "[parameters('homepageUrl')]",
          "redirectUris": [
            "[format('{0}/auth/callback', parameters('homepageUrl'))]"
          ]
        },
        "appRoles": [
          {
            "id": "[guid(parameters('applicationDisplayName'), 'sandboxd.user')]",
            "allowedMemberTypes": [
              "User"
            ],
            "description": "Use the sandboxd console and API.",
            "displayName": "sandboxd user",
            "isEnabled": true,
            "value": "sandboxd.user"
          },
          {
            "id": "[guid(parameters('applicationDisplayName'), 'sandboxd.admin')]",
            "allowedMemberTypes": [
              "User"
            ],
            "description": "Administer sandboxd and its production settings.",
            "displayName": "sandboxd administrator",
            "isEnabled": true,
            "value": "sandboxd.admin"
          }
        ]
      }
    },
    "sandboxdServicePrincipal": {
      "import": "microsoftGraphV1",
      "type": "Microsoft.Graph/servicePrincipals@v1.0",
      "properties": {
        "appId": "[reference('sandboxdApplication').appId]"
      },
      "dependsOn": [
        "sandboxdApplication"
      ]
    },
    "userRoleAssignment": {
      "import": "microsoftGraphV1",
      "type": "Microsoft.Graph/appRoleAssignedTo@v1.0",
      "properties": {
        "appRoleId": "[guid(parameters('applicationDisplayName'), 'sandboxd.user')]",
        "principalId": "[parameters('userGroupObjectId')]",
        "resourceId": "[reference('sandboxdServicePrincipal').id]"
      },
      "dependsOn": [
        "sandboxdServicePrincipal"
      ]
    },
    "adminRoleAssignment": {
      "import": "microsoftGraphV1",
      "type": "Microsoft.Graph/appRoleAssignedTo@v1.0",
      "properties": {
        "appRoleId": "[guid(parameters('applicationDisplayName'), 'sandboxd.admin')]",
        "principalId": "[parameters('adminGroupObjectId')]",
        "resourceId": "[reference('sandboxdServicePrincipal').id]"
      },
      "dependsOn": [
        "sandboxdServicePrincipal"
      ]
    }
  },
  "outputs": {
    "applicationClientId": {
      "type": "string",
      "value": "[reference('sandboxdApplication').appId]"
    },
    "servicePrincipalObjectId": {
      "type": "string",
      "value": "[reference('sandboxdServicePrincipal').id]"
    }
  }
}